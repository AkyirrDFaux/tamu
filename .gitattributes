# Language statistics (GitHub linguist) -------------------------------------
# This repository is two languages: C++ (firmware) and Dart (app).
# Anything else tracked here is docs, configuration, generated or a binary asset.

# --- C++ ---------------------------------------------------------------
# Headers are C++ here, not C; without this GitHub reports them as C.
*.h      linguist-language=C++
*.hpp    linguist-language=C++
*.hxx    linguist-language=C++
*.ino    linguist-language=C++
*.cpp    linguist-language=C++
*.cc     linguist-language=C++
*.c      linguist-language=C++
*.S      linguist-language=Assembly
*.s      linguist-language=Assembly

# --- Generated code is not hand-written source --------------------------
*.g.dart                                  linguist-generated=true
*.freezed.dart                            linguist-generated=true
*.mocks.dart                              linguist-generated=true
app/lib/core/app_version.g.dart           linguist-generated=true

# --- Flutter platform runners are generated by `flutter create` ---------
app/android/**   linguist-vendored
app/ios/**       linguist-vendored
app/linux/**     linguist-vendored
app/macos/**     linguist-vendored
app/web/**       linguist-vendored
app/windows/**   linguist-vendored
app/build/**     linguist-vendored
**/*.iml         linguist-vendored

# --- Documentation and assets carry no language -------------------------
*.md      linguist-documentation
app/doc/** linguist-documentation

*.png   binary
*.ico   binary
*.jpg   binary
*.jpeg  binary
*.step  binary
*.stl   binary
*.FCStd binary
*.zip   binary
